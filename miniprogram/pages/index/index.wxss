.page { max-width: 1000rpx; margin: 0 auto; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.hero { padding: 8rpx 6rpx 32rpx; }
.brand-row, .card-heading, .account-row, .account-label, .history-top, .history-bottom, .date-input { display: flex; align-items: center; justify-content: space-between; }
.brand-row { justify-content: flex-start; gap: 14rpx; margin-bottom: 32rpx; }
.brand-mark { width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; background: #2468e8; color: #fff; border-radius: 17rpx; font-weight: 700; }
.eyebrow { font-size: 22rpx; letter-spacing: 2rpx; color: #52617a; font-weight: 600; }
.beta { margin-left: auto; border: 1rpx solid #dbe3ef; padding: 3rpx 13rpx; border-radius: 30rpx; color: #65738a; font-size: 19rpx; }
.hero-title { display: block; font-size: 52rpx; font-weight: 750; letter-spacing: -1rpx; }
.hero-subtitle { display: block; font-size: 25rpx; color: #66758d; margin-top: 10rpx; }
.hero-tags { display: flex; gap: 14rpx; margin-top: 22rpx; }
.hero-tags text { font-size: 20rpx; color: #3e6094; background: #e9effa; border-radius: 8rpx; padding: 4rpx 14rpx; }
.card { background: #fff; border: 1rpx solid #e8edf5; border-radius: 28rpx; padding: 30rpx; margin-bottom: 26rpx; box-shadow: 0 8rpx 30rpx rgba(24, 45, 82, .025); }
.card-title { display: block; font-size: 33rpx; font-weight: 700; }
.card-heading { margin-bottom: 26rpx; gap: 12rpx; }
.step-label, .section-kicker { color: #74839a; font-size: 20rpx; letter-spacing: 1rpx; }
.section-kicker { display: block; margin-bottom: 8rpx; }
.muted { display: block; color: #65738a; font-size: 25rpx; }
.small { display: block; font-size: 22rpx; color: #748198; }
.intro { margin: 16rpx 0 26rpx; line-height: 1.8; }
.notice { display: flex; flex-direction: column; gap: 13rpx; background: #f4f7fb; border-radius: 18rpx; padding: 24rpx; font-size: 24rpx; color: #5d6d84; line-height: 1.85; }
.notice-title { display: block; font-weight: 600; color: #34465f; font-size: 26rpx; }
.consent { display: flex; align-items: flex-start; font-size: 24rpx; margin: 28rpx 0; color: #485a73; }
.consent checkbox { transform: scale(.82); transform-origin: left top; width: 49rpx; flex-shrink: 0; }
.button-primary { width: 100%; min-height: 90rpx; line-height: 1.5; padding: 23rpx 18rpx; background: #2468e8; color: white; font-weight: 600; border-radius: 16rpx; margin: 26rpx 0 14rpx; }
.button-primary[disabled] { background: #2468e8; color: #fff; }
.button-text { display: inline-block; padding: 0 6rpx; margin: 0; background: transparent; color: #2468e8; font-size: 24rpx; line-height: 1.8; border-radius: 4rpx; }
.button-text[disabled] { color: #677991; background: transparent; }
.centered { text-align: center; margin-top: 18rpx; }
.account-row { margin: 0 4rpx 18rpx; }
.account-label { justify-content: flex-start; gap: 10rpx; color: #68778d; font-size: 23rpx; }
.online-dot { width: 12rpx; height: 12rpx; background: #24a480; border-radius: 50%; }
.quota-card { display: flex; justify-content: space-between; align-items: center; background: #193456; padding: 28rpx 32rpx; border-radius: 24rpx; color: #fff; margin-bottom: 26rpx; }
.quota-label { color: #bacbe2; font-size: 24rpx; }
.quota-number { font-size: 58rpx; font-weight: 650; line-height: 1.5; }
.quota-number text { font-size: 24rpx; font-weight: 400; color: #d3dfef; }
.quota-pending { font-size: 36rpx; padding-top: 10rpx; }
.quota-meta { display: flex; flex-direction: column; text-align: right; font-size: 21rpx; color: #bacbe2; line-height: 1.9; }
.field-label { display: block; font-size: 25rpx; font-weight: 600; margin-bottom: 12rpx; }
.ticker-input { height: 96rpx; padding: 0 24rpx; border: 1rpx solid #dbe4f0; background: #fbfcfe; border-radius: 15rpx; font-size: 34rpx; font-weight: 600; letter-spacing: 1rpx; }
.examples { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 18rpx 0 12rpx; }
.examples button { margin: 0; padding: 7rpx 17rpx; background: #f0f4fa; color: #4f6590; font-size: 21rpx; line-height: 1.6; border-radius: 10rpx; }
.date-label { margin-top: 26rpx; }
.date-input { min-height: 85rpx; border: 1rpx solid #dbe4f0; border-radius: 15rpx; padding: 18rpx 22rpx; margin-bottom: 10rpx; }
.date-icon { font-size: 22rpx; color: #65738a; }
.form-note { font-size: 21rpx; line-height: 1.85; }
.error { background: #fff3f0; border: 1rpx solid #f7ded7; border-radius: 14rpx; color: #a44736; padding: 20rpx; margin: 16rpx 0; font-size: 24rpx; line-height: 1.8; overflow-wrap: break-word; }
.error-retry { display: block; text-align: left; margin-top: 8rpx; color: #a44736; }
.pending-notice { background: #fff8e7; border-radius: 15rpx; padding: 22rpx; margin-top: 22rpx; color: #86652b; font-size: 23rpx; line-height: 1.9; }
.pending-notice .notice-title { color: #86652b; margin-bottom: 8rpx; }
.request-id, .task-id { display: block; overflow-wrap: anywhere; word-break: break-all; font-size: 20rpx; margin-top: 12rpx; }
.request-id { font-family: monospace; }
.status { display: inline-block; font-size: 21rpx; padding: 4rpx 14rpx; border-radius: 30rpx; white-space: nowrap; font-weight: 500; }
.status-queued { background: #fff4db; color: #946b17; }
.status-running { background: #eaf1ff; color: #2468e8; }
.status-succeeded { background: #e8f6f0; color: #167756; }
.status-failed, .status-unknown { background: #f9ede9; color: #a44736; }
.result-ticker { display: block; font-size: 42rpx; font-weight: 700; margin-bottom: 3rpx; }
.progress-panel { margin: 26rpx 0; padding: 28rpx; border-radius: 20rpx; background: #f3f7ff; display: flex; flex-direction: column; gap: 14rpx; }
.progress-orb { width: 28rpx; height: 28rpx; background: #2468e8; border: 7rpx solid #d5e3ff; border-radius: 50%; box-shadow: 0 0 0 7rpx #e8efff; margin: 8rpx 0; }
.failed-panel { display: flex; flex-direction: column; gap: 14rpx; padding: 24rpx; margin: 24rpx 0; background: #fff5f1; border-radius: 18rpx; color: #915947; font-size: 25rpx; }
.decision-card { margin: 26rpx 0 20rpx; padding: 26rpx; border-radius: 20rpx; background: #f2f6fc; }
.rating { display: block; color: #244d87; font-size: 35rpx; font-weight: 650; margin: 8rpx 0 22rpx; }
.report-text { display: block; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; font-size: 26rpx; line-height: 1.95; color: #374962; }
.report-section { border-bottom: 1rpx solid #ebeff5; }
.report-toggle { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; padding: 24rpx 0; margin: 0; background: transparent; border-radius: 0; text-align: left; color: #34465f; font-size: 27rpx; line-height: 1.6; font-weight: 600; }
.report-toggle text:last-child { font-size: 22rpx; color: #748198; font-weight: 400; white-space: nowrap; }
.report-body { padding: 0 0 24rpx; }
.disclaimer { margin-top: 26rpx; font-size: 23rpx; background: #faf7ef; color: #827150; }
.disclaimer .notice-title { color: #76633f; }
.task-id { margin-top: 24rpx; }
.history-card .card-heading { margin-bottom: 14rpx; }
.history-item { display: block; background: #fff; width: 100%; border: 1rpx solid #e9edf4; border-radius: 15rpx; padding: 20rpx; text-align: left; margin: 14rpx 0 0; line-height: 1.7; }
.history-selected { background: #f4f8ff; border-color: #bdd2f7; }
.history-ticker { font-size: 29rpx; font-weight: 650; color: #263b58; }
.history-bottom { margin-top: 10rpx; font-size: 20rpx; color: #7b889b; gap: 10rpx; flex-wrap: wrap; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 28rpx 0; color: #64758e; font-size: 26rpx; }
.empty-mark { border: 1rpx dashed #c4d2e7; color: #9aafcb; width: 70rpx; height: 70rpx; text-align: center; line-height: 70rpx; font-size: 35rpx; border-radius: 20rpx; margin-bottom: 8rpx; }
.footer { display: flex; flex-direction: column; gap: 8rpx; text-align: center; color: #92a0b2; font-size: 20rpx; padding: 14rpx 0 8rpx; }
